# Line endings: git stores LF; a Windows checkout gets CRLF through core.autocrlf (set by Git for Windows).
* text=auto

# Run on the board (Linux): always LF
engine/board/*.py text eol=lf
*.sh text eol=lf

# Binary files: never converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.pdf binary
*.onnx binary
*.zip binary
*.exe binary
*.dll binary
