<UserControl x:Class="TopstToolkit.App.Shells.Rail.RailShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:vm="clr-namespace:TopstToolkit.App.ViewModels"
             xmlns:pages="clr-namespace:TopstToolkit.App.Shells.Rail.Pages">
    <!-- Screen layout A "step rail" (docs/mockups/mockup-a-rail.html). DataContext: ShellViewModel. -->
    <UserControl.Resources>
        <!-- which view shows which view model in THIS layout -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><pages:HomePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelStepViewModel}"><pages:ModelPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}"><pages:ConfigPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataViewModel}"><pages:DataPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BuildViewModel}"><pages:BuildPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}"><pages:ResultPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerfViewModel}"><pages:PerfPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}"><pages:ExportPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelCheckViewModel}"><pages:CheckPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphCutViewModel}"><pages:GraphPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><pages:PlaceholderPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComponentsViewModel}"><pages:ComponentsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZooViewModel}"><pages:ZooPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoardViewModel}"><pages:BoardPage/></DataTemplate>

        <Style x:Key="Header.Pill" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="15" Padding="8,0,12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Surface.RailHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the update pill (mockup-update): the board pill's shape, tinted for a new version, green when done, red when not -->
        <Style x:Key="Header.Pill.Update" TargetType="Button" BasedOn="{StaticResource Header.Pill}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
            <Setter Property="BorderBrush" Value="#C6D1E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="10,0,12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Update.PillIsDone}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
                    <Setter Property="Background" Value="{StaticResource Brush.Status.SuccessBg}"/>
                    <Setter Property="BorderBrush" Value="#BFE3CF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Update.PillIsFailed}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
                    <Setter Property="Background" Value="{StaticResource Brush.Status.DangerBg}"/>
                    <Setter Property="BorderBrush" Value="#F3C5C1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Rail.NavItem" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource Rail.Item}" IsEnabled="{Binding IsEnabled}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <DockPanel LastChildFill="True">
                    <c:StatusDot DockPanel.Dock="Right" State="{Binding State}" Visibility="{Binding IsStep, Converter={StaticResource VisibleWhen}}"/>
                    <Grid DockPanel.Dock="Left" Width="20" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource Font.Brand}" FontSize="12" FontWeight="SemiBold" Opacity="0.65"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <c:Icon Glyph="{Binding Glyph}" FontSize="16"/>
                    </Grid>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </DockPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Log.Line" DataType="{x:Type vm:LogLine}">
            <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{StaticResource Brush.Log.Text}"
                       LineStackingStrategy="BlockLineHeight" LineHeight="19" TextTrimming="CharacterEllipsis"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                    <Setter TargetName="t" Property="Foreground" Value="#72E7AD"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: project, caption, the one primary action -->
        <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="20,0,16,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Height="32" Padding="12,0,10,0" VerticalAlignment="Center"
                        Command="{Binding NavigateCommand}" CommandParameter="{Binding HomeItem}" ToolTip="프로젝트 목록으로">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="Folder" FontSize="14" Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Text="{Binding ProjectName}" Margin="8,0" Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        <c:Icon Glyph="ChevronDown" FontSize="10" Foreground="{StaticResource Brush.Text.Muted}"/>
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ProjectCaption}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" VerticalAlignment="Center" Command="{Binding BuildCommand}"
                        Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="Play" FontSize="12"/>
                        <TextBlock Text="빌드" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" Command="{Binding CancelBuildCommand}"
                        Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="Stop" FontSize="12"/>
                        <TextBlock Text="빌드 취소" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="False" ToolTip="도움말은 다음 단계에서 추가합니다">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="Help" FontSize="14"/>
                        <TextBlock Text="도움말" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- the board at a glance (mockup-board): on every page once connected; "연결 안 됨" on the board page only -->
                <Button DockPanel.Dock="Right" Style="{StaticResource Header.Pill}" Margin="0,0,10,0" VerticalAlignment="Center"
                        Command="{Binding OpenBoardCommand}" ToolTip="보드"
                        Visibility="{Binding Board.IsConnected, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <c:StatusDot State="{Binding Board.PillState}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Board.PillText}" Margin="5,0,0,0" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Board.PillTemperature}" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Header.Pill}" Margin="0,0,10,0" VerticalAlignment="Center"
                        Command="{Binding OpenBoardCommand}" Visibility="{Binding ShowsBoardOffPill, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <c:StatusDot State="Todo" VerticalAlignment="Center"/>
                        <TextBlock Text="보드 연결 안 됨" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- a new version, its download, how an update ended (design §7.5): 설정 › 정보 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource Header.Pill.Update}" Margin="0,0,10,0" VerticalAlignment="Center"
                        Command="{Binding OpenUpdateCommand}" ToolTip="설정 › 정보의 업데이트"
                        Visibility="{Binding Update.ShowsPill, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Topst.Pulse}" VerticalAlignment="Center"
                                 Visibility="{Binding Update.PillIsNew, Converter={StaticResource VisibleWhen}}"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Danger}" VerticalAlignment="Center"
                                 Visibility="{Binding Update.PillIsFailed, Converter={StaticResource VisibleWhen}}"/>
                        <c:Icon Glyph="Accept" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Brush.Status.Success}"
                                Visibility="{Binding Update.PillIsDone, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="{Binding Update.PillText}" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- step rail -->
            <Border Background="{StaticResource Brush.Surface.Rail}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8,10,8,12" LastChildFill="True">
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding SettingsItem}" ContentTemplate="{StaticResource Rail.NavItem}" Focusable="False"/>
                        <!-- Telechips wordmark, single colour (design system §7) -->
                        <Viewbox Grid.Column="1" Width="62" Height="12" Margin="4,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource Brand.Telechips}" Fill="{StaticResource Brush.Text.Muted}" Width="130" Height="24" Stretch="None"/>
                        </Viewbox>
                    </Grid>
                    <StackPanel>
                        <ContentControl Content="{Binding HomeItem}" ContentTemplate="{StaticResource Rail.NavItem}" Focusable="False"/>
                        <TextBlock Text="프로젝트" Style="{StaticResource Text.Overline}" Margin="12,14,12,4"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="12,4,12,4"
                                   Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"><Run Text="프로젝트를 열면"/><LineBreak/><Run Text="단계가 여기에 나옵니다."/></TextBlock>
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource Rail.NavItem}" Focusable="False"
                                      Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="도구" Style="{StaticResource Text.Overline}" Margin="12,14,12,4"/>
                        <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource Rail.NavItem}" Focusable="False"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- the step page -->
                <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>

                <!-- log drawer: what the toolkit prints, as it is -->
                <Border Grid.Row="1" Height="118" Background="{StaticResource Brush.Log.Background}"
                        Visibility="{Binding IsLogOpen, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,10,6,10">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource Log.Line}" Focusable="False"/>
                        </ScrollViewer>
                        <TextBlock x:Name="LogEmpty" Text="아직 출력이 없습니다. 빌드를 시작하면 툴킷이 내는 글이 그대로 여기에 나옵니다." FontFamily="{StaticResource Font.Ui}" FontSize="12"
                                   Foreground="{StaticResource Brush.Log.Dim}" Margin="16,10" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- task bar: what is running, progress, log -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Background="White">
                    <DockPanel LastChildFill="False" Margin="12,0,12,0">
                        <c:StatusDot DockPanel.Dock="Left" State="{Binding TaskState}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TaskTitle}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TaskDetail}" Style="{StaticResource Text.Label}" FontWeight="Normal" MaxWidth="300"
                                   Foreground="{StaticResource Brush.Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <ProgressBar DockPanel.Dock="Left" Style="{StaticResource Progress.Pulse}" Width="240" Margin="14,0,0,0" VerticalAlignment="Center"
                                     Value="{Binding TaskProgress, Mode=OneWay}" Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TaskClock}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Muted}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="취소" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{Binding CancelBuildCommand}" Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" VerticalAlignment="Center" Command="{Binding ToggleLogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="Terminal" FontSize="14"/>
                                <TextBlock Text="로그" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                <c:Icon x:Name="LogChevron" Glyph="ChevronUp" FontSize="9"/>
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding EngineCaption}" Style="{StaticResource Text.Caption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
