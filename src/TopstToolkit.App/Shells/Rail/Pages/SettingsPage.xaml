<UserControl x:Class="TopstToolkit.App.Shells.Rail.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:vm="clr-namespace:TopstToolkit.App.ViewModels">
    <!-- App page "설정" in layout A, in tabs (docs/mockups/mockup-components.html ⑤). DataContext: SettingsViewModel. -->
    <DockPanel Margin="32,22,32,20">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="설정" Style="{StaticResource Page.Title}"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Seg.Frame}" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Seg}" GroupName="settings" Tag="first" Content="작업 공간" IsChecked="{Binding IsWorkspaceTab}"/>
                <RadioButton Style="{StaticResource Seg}" GroupName="settings" Content="구성 요소" IsChecked="{Binding IsComponentsTab}"/>
                <RadioButton Style="{StaticResource Seg}" GroupName="settings" Content="화면 구조" IsChecked="{Binding IsLayoutTab}"/>
                <RadioButton Style="{StaticResource Seg}" GroupName="settings" Tag="last" Content="정보" IsChecked="{Binding IsAboutTab}"/>
            </StackPanel>
        </Border>

        <Grid>
            <!-- ======== 작업 공간 ======== -->
            <StackPanel MaxWidth="880" HorizontalAlignment="Left" Visibility="{Binding IsWorkspaceTab, Converter={StaticResource VisibleWhen}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="작업 공간" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Text="프로젝트와 빌드 결과를 두는 폴더입니다. 툴킷이 한글 경로를 읽지 못해서 영문 경로여야 합니다." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <Border Height="36" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Surface.Rail}">
                            <DockPanel Margin="12,0,4,0" LastChildFill="True">
                                <c:Icon DockPanel.Dock="Left" Glyph="Folder" FontSize="14" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,8,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="위치 바꾸기" Command="{Binding ChangeWorkspaceCommand}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="폴더 열기" Command="{Binding OpenWorkspaceCommand}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding WorkspaceText}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" ToolTip="{Binding WorkspaceText}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding WorkspaceNote}" TextWrapping="Wrap" Visibility="{Binding WorkspaceNote, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Help}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkspaceNoteIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- 저장 폴더 (2026-11-25): 내 문서\TOPST Toolkit, where exports and board results go -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="저장 폴더" Style="{StaticResource Text.Subtitle}"/>
                        <TextBlock Text="내보낸 보드용 폴더와 보드에서 받은 결과(사진 · 영상 · 표)를 두는 곳입니다. 저장할 때마다 다른 곳을 고를 수도 있어요." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <Border Height="36" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Surface.Rail}">
                            <DockPanel Margin="12,0,4,0" LastChildFill="True">
                                <c:Icon DockPanel.Dock="Left" Glyph="Folder" FontSize="14" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,8,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="위치 바꾸기" Command="{Binding ChangeSaveRootCommand}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="폴더 열기" Command="{Binding OpenSaveRootCommand}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SaveRootText}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" ToolTip="{Binding SaveRootText}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding SaveRootNote}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding SaveRootNote, Converter={StaticResource VisibleWhen}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="실행 기록 보관" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Text="툴킷이 낸 글(로그)을 프로젝트 폴더에 이 기간만큼 둡니다." Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="일" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Input.Number}" Width="72" TextAlignment="Right" Text="{Binding LogDaysText, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ======== 구성 요소 (design D12) ======== -->
            <!-- the tab switch binds to this page, the content to the components (a Visibility next to DataContext would bind to the latter and never hide) -->
            <Border Visibility="{Binding IsComponentsTab, Converter={StaticResource VisibleWhen}}">
            <StackPanel DataContext="{Binding Components}">
                <Border Style="{StaticResource Callout.Warning}" Margin="0,0,0,12" Visibility="{Binding Notice, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Notice}" Style="{StaticResource Callout.Text}"/>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Brush.Surface.TableHead}" CornerRadius="8" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="구성 요소" Style="{StaticResource Table.Head}"/>
                                <TextBlock Grid.Column="1" Text="상태" Style="{StaticResource Table.Head}"/>
                                <TextBlock Grid.Column="2" Text="들어 있는 것" Style="{StaticResource Table.Head}"/>
                                <TextBlock Grid.Column="3" Text="크기" Style="{StaticResource Table.Head}" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontSize="13">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding RequiredText, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Muted}"/>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:Chip Text="{Binding StateText}" Kind="{Binding StateKind}"/>
                                                <TextBlock Text="{Binding InstalledOn}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Contents}" Style="{StaticResource Text.Mono}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Text.Body}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Secondary.Small}" Content="설치" Visibility="{Binding CanInstall, Converter={StaticResource VisibleWhen}}"
                                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Button.Secondary.Small}" Content="다시 설치" Visibility="{Binding CanReinstall, Converter={StaticResource VisibleWhen}}"
                                                        Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Button.Quiet.Small}" Content="지우기" Margin="6,0,0,0" Visibility="{Binding CanRemove, Converter={StaticResource VisibleWhen}}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel LastChildFill="True" Margin="0,14,0,0">
                            <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"><Run Text="받아 둔 파일 "/><Run Text="{Binding KeptText, Mode=OneWay}"/></TextBlock>
                                <Button Style="{StaticResource Button.Secondary.Small}" Content="지우기" HorizontalAlignment="Right" Margin="0,4,0,0" Command="{Binding DeleteKeptCommand}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="설치 위치" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                                <Border Height="32" Background="{StaticResource Brush.Surface.Sunken}" CornerRadius="6">
                                    <DockPanel Margin="10,0,4,0" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="바꾸기" Command="{Binding ChangeLocationCommand}" VerticalAlignment="Center"
                                                Visibility="{Binding LocationIsFixed, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="폴더 열기" Command="{Binding OpenLocationCommand}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Mono}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Location}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource Text.Help}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LocationNote}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.Status.Warning}" Visibility="{Binding LocationNote, Converter={StaticResource VisibleWhen}}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Callout}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Callout.Text}"
                               Text="엔진을 쓰는 빌드가 돌고 있으면 다시 설치하거나 지울 수 없어요. 프로젝트는 구성 요소와 따로 있어서, 다시 설치해도 그대로입니다."/>
                </Border>
            </StackPanel>
            </Border>

            <!-- ======== 화면 구조 (decision D9) ======== -->
            <Border Style="{StaticResource Card}" MaxWidth="880" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsLayoutTab, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="화면 구조" Style="{StaticResource Text.Subtitle}"/>
                    <TextBlock Text="같은 기능을 세 가지 배치로 볼 수 있게 할 예정입니다. 지금은 A만 쓸 수 있습니다." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <ItemsControl ItemsSource="{Binding Layouts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LayoutChoice}">
                                <Grid Margin="0,0,0,8">
                                    <Border x:Name="frame" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="12" Background="White"/>
                                    <Border x:Name="on" BorderBrush="{StaticResource Brush.Brand.Primary}" BorderThickness="2" CornerRadius="12" Visibility="Collapsed"/>
                                    <DockPanel x:Name="row" Margin="14,10" LastChildFill="False">
                                        <Border x:Name="badge" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="{StaticResource Brush.Text.Heading}">
                                            <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource Font.Brand}" FontSize="14" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" LineHeight="20"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                        <c:Chip DockPanel.Dock="Right" Text="{Binding ChipText}" Kind="{Binding ChipKind}"/>
                                    </DockPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="on" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="frame" Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
                                        <Setter TargetName="badge" Property="Background" Value="{StaticResource Brush.Brand.Primary}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter TargetName="frame" Property="Background" Value="{StaticResource Brush.Surface.Rail}"/>
                                        <Setter TargetName="badge" Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======== 정보: app updates (design §7.5, mockup-update), the engine check and what this app is ======== -->
            <!-- scrolls when the update card is tall; at most 880 wide and on the left, the two cards below it of equal width -->
            <ScrollViewer Visibility="{Binding IsAboutTab, Converter={StaticResource VisibleWhen}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="880"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top" Margin="0,0,0,4">
            <!-- the tint ring while there is something to do (a new version, its download, the install) -->
            <Border DataContext="{Binding Update}" CornerRadius="15" Padding="3" Margin="-3,-3,-3,9"
                    Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Padding="18,16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="BorderBrush" Value="#BFCBE4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="업데이트" Style="{StaticResource Text.Subtitle}"/>
                            <c:Chip DockPanel.Dock="Right" Text="{Binding ChipText}" Kind="{Binding ChipKind}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Lead}" Style="{StaticResource Text.Secondary}" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <!-- ④ the download -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}">
                            <ProgressBar Style="{StaticResource Progress.Pulse}" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"/>
                            <DockPanel LastChildFill="True" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="취소" Command="{Binding CancelCommand}"/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- what changed -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowsNotes, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding NotesTitle}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Heading}"/>
                            <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                            <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{StaticResource Brush.Brand.Primary}" Margin="4,8,9,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" FontSize="13.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- the one step forward, or a retry -->
                        <DockPanel LastChildFill="True" Margin="0,14,0,0" Visibility="{Binding ShowsPrimary, Converter={StaticResource VisibleWhen}}">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Primary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                                    Visibility="{Binding PrimaryIsAccent, Converter={StaticResource VisibleWhen}}"/>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                                    Visibility="{Binding PrimaryIsAccent, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Link}" Content="설치 기록" Command="{Binding OpenLogCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowsLog, Converter={StaticResource VisibleWhen}}"/>
                            <TextBlock Text="{Binding PrimaryHelp}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </DockPanel>

                        <!-- ⑤ Windows' question for an install in Program Files -->
                        <Border Style="{StaticResource Callout}" Margin="0,12,0,0" Visibility="{Binding ShowsAdminNote, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Callout.Text}" Text="Windows가 이 앱이 변경해도 되는지 물으면 [예]를 눌러 주세요. 모든 사용자용으로 설치해서 한 번 묻습니다."/>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>
                        <DockPanel LastChildFill="False">
                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Toggle}" FontSize="13" Content="켤 때 새 버전 확인" IsChecked="{Binding CheckOnStart}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="지금 확인" Command="{Binding CheckNowCommand}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastCheckedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="엔진" Style="{StaticResource Text.Subtitle}"/>
                            <c:Chip DockPanel.Dock="Right" Text="{Binding EngineChipText}" Kind="{Binding EngineChipKind}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Engine}" ItemTemplate="{StaticResource Part.Fact}" Focusable="False"/>
                        <Button Style="{StaticResource Button.Secondary}" Content="다시 점검" Command="{Binding RecheckCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                IsEnabled="{Binding IsChecking, Converter={StaticResource Not}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="정보" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding About}" ItemTemplate="{StaticResource Part.Fact}" Focusable="False"/>
                        <Border Style="{StaticResource Divider}" Margin="0,10"/>
                        <DockPanel LastChildFill="False">
                            <Viewbox DockPanel.Dock="Left" Width="74" Height="14">
                                <Path Data="{StaticResource Brand.Telechips}" Fill="{StaticResource Brush.Text.Muted}" Width="130" Height="24" Stretch="None"/>
                            </Viewbox>
                            <TextBlock DockPanel.Dock="Right" Text="ENLIGHT SDK © OPENEDGES" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
