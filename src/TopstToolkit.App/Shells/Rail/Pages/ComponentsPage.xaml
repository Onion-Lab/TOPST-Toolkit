<UserControl x:Class="TopstToolkit.App.Shells.Rail.Pages.ComponentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:vm="clr-namespace:TopstToolkit.App.ViewModels">
    <!-- "구성 요소" in layout A (design D12, docs/mockups/mockup-components.html ①–④). DataContext: ComponentsViewModel. -->
    <UserControl.Resources>
        <!-- one line of the install: state, what it does, how far, size -->
        <DataTemplate x:Key="Components.Step" DataType="{x:Type vm:InstallStepViewModel}">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:StatusDot State="{Binding State}" VerticalAlignment="Top" Margin="2,5,0,0"/>
                    <StackPanel Grid.Column="1" Margin="10,0,16,0">
                        <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20"/>
                        <ProgressBar Style="{StaticResource Progress.Pulse}" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,6,0,4"
                                     Visibility="{Binding HasBar, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Right}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Todo">
                    <Setter TargetName="title" Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,22,32,20">

        <!-- ================= ① what will be installed, from where, under which license ================= -->
        <DockPanel Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SetupTitle}" Style="{StaticResource Page.Title}"/>
                <c:Chip DockPanel.Dock="Left" Text="엔진 없음" Kind="Warn" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding EngineReady, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SetupNote}" Style="{StaticResource Page.Note}"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="312"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="-3,-3,-13,0" Padding="3,3,13,0">
                    <StackPanel>
                        <Border Style="{StaticResource Callout.Danger}" Margin="0,0,0,12" Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Problem}" Style="{StaticResource Callout.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Callout.Warning}" Margin="0,0,0,12" Visibility="{Binding Notice, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Notice}" Style="{StaticResource Callout.Text}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                    <Grid Margin="0,0,0,12">
                                        <Border x:Name="frame" Style="{StaticResource Card}" Padding="18,16"/>
                                        <Border x:Name="on" BorderBrush="{StaticResource Brush.Brand.Primary}" BorderThickness="1.5" CornerRadius="12" Visibility="Collapsed"/>
                                        <StackPanel Margin="18,16">
                                            <DockPanel LastChildFill="True">
                                                <!-- a box only for what can be left out; required components (both, since 2026-11-22) have none -->
                                                <CheckBox x:Name="pick" DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsChoosable, Converter={StaticResource VisibleWhen}}"/>
                                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Brand.PrimaryTint}" Margin="0,0,12,0">
                                                    <c:Icon Glyph="{Binding Glyph}" FontSize="18" Foreground="{StaticResource Brush.Brand.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <StackPanel Visibility="{Binding NeedsInstall, Converter={StaticResource VisibleWhen}}">
                                                        <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right">
                                                            <Run Text="받을 양 "/><Run Text="{Binding DownloadText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Heading}"/>
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right">
                                                            <Run Text="설치 후 "/><Run Text="{Binding InstalledSizeText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <c:Chip Text="{Binding StateText}" Kind="{Binding StateKind}" HorizontalAlignment="Right"
                                                            Visibility="{Binding NeedsInstall, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" FontSize="15"/>
                                                        <c:Chip Text="{Binding RequiredText}" Kind="Muted" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- what is downloaded, from whom, under which license -->
                                            <ItemsControl ItemsSource="{Binding Sources}" Focusable="False" Margin="0,12,0,0"
                                                          Visibility="{Binding NeedsInstall, Converter={StaticResource VisibleWhen}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SourceRow}">
                                                        <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="200"/>
                                                                    <ColumnDefinition Width="72"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Origin}" Style="{StaticResource Text.Caption}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap">
                                                                    <Hyperlink Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               CommandParameter="{Binding}" Foreground="{StaticResource Brush.Brand.Primary}"><Run Text="{Binding LinkText, Mode=OneWay}"/></Hyperlink>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{StaticResource Text.Caption}" FontSize="12.5" LineHeight="19" TextAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding NeedsInstall}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="on" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Agreed}" Margin="0,2,0,0" VerticalContentAlignment="Top" IsEnabled="{Binding HasProblem, Converter={StaticResource Not}}"
                                  AutomationProperties.Name="출처와 라이선스에 동의">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20">
                                <Run Text="위 라이선스를 확인했고, "/><Run Text="TOPST 이용 조건" FontWeight="SemiBold"/><Run Text="에 동의합니다."/>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="설치할 것" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="받을 양" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="26"/>
                                <TextBlock Grid.Column="1" Text="{Binding DownloadTotal}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="26" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="설치 후 디스크" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="26"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiskAfter}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="26" TextAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="설치하는 동안 필요한 공간" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="26"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiskDuring}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="26" TextAlignment="Right"/>
                                <TextBlock Grid.Row="3" Text="걸리는 시간" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="26"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="26" TextAlignment="Right"/>
                            </Grid>
                            <DockPanel LastChildFill="False" Margin="0,12,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="설치 위치" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Quiet.Small}" Content="바꾸기" Command="{Binding ChangeLocationCommand}"
                                        Visibility="{Binding LocationIsFixed, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                            </DockPanel>
                            <Border Background="{StaticResource Brush.Surface.Sunken}" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Mono}" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding LocationNote}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Status.Warning}" Visibility="{Binding LocationNote, Converter={StaticResource VisibleWhen}}"/>
                            <TextBlock Text="{Binding SpaceWarning}" Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Status.Danger}" Visibility="{Binding SpaceWarning, Converter={StaticResource VisibleWhen}}"/>
                            <Button Style="{StaticResource Button.Primary}" Height="44" FontSize="15" Margin="0,14,0,0" Command="{Binding InstallCommand}" Content="동의하고 설치"/>
                            <TextBlock Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="동의에 표시하면 누를 수 있어요. 설치하는 동안 다른 프로젝트는 열 수 없지만, 창을 닫지 않으면 됩니다."/>
                            <TextBlock Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,0" Text="설치할 것이 없어요. 고른 구성 요소가 이미 있습니다."
                                       Visibility="{Binding NothingToInstall, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Callout}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Callout.Text}"
                                   Text="TOPST Toolkit 설치 파일에는 이 프로그램만 들어 있어요. 툴킷 · 컴파일러 · Python 패키지는 지금 이 PC에서 공식 사이트로부터 받습니다."/>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ================= ② the install: each line, how far, the whole ================= -->
        <DockPanel Visibility="{Binding IsInstalling, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="{Binding InstallTitle}" Style="{StaticResource Page.Title}"/>
                <c:Chip DockPanel.Dock="Left" Text="설치 중" Kind="Running" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Page.Note}"><Run Text="지난 시간 "/><Run Text="{Binding ElapsedText, Mode=OneWay}"/></TextBlock>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="312"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentTitle}" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentCount}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="받은 뒤 SHA-256을 확인합니다" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource Components.Step}" Focusable="False" VerticalAlignment="Top"/>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="전체" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding OverallText}" FontFamily="{StaticResource Font.Brand}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Heading}" Margin="0,4,0,8"/>
                            <ProgressBar Style="{StaticResource Progress.Pulse}" Maximum="1" Value="{Binding Overall, Mode=OneWay}"/>
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,16,0,0" Command="{Binding CancelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="Stop" FontSize="12"/>
                                    <TextBlock Text="취소" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ================= ③ done ================= -->
        <DockPanel Visibility="{Binding IsDone, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="{Binding DoneTitle}" Style="{StaticResource Page.Title}"/>
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Installed}" Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                            <c:Chip Text="{Binding Title, StringFormat={}{0} 설치됨}" Kind="Ok" Margin="0,0,6,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedTotal}" Style="{StaticResource Page.Note}"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="312"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Background="{StaticResource Brush.Status.SuccessBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="Accept" FontSize="14" Foreground="{StaticResource Brush.Status.Success}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="13" Foreground="{StaticResource Brush.Status.Success}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding DoneText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" 모델을 가져와 빌드할 수 있습니다."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Installed}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Brand.PrimaryTint}" Margin="0,0,12,0">
                                            <c:Icon Glyph="{Binding Glyph}" FontSize="18" Foreground="{StaticResource Brush.Brand.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <c:Chip DockPanel.Dock="Right" Text="확인됨" Kind="Ok" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" FontSize="15"/>
                                            <TextBlock Text="{Binding Checked}" Style="{StaticResource Text.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource Button.Primary}" Height="44" FontSize="15" Command="{Binding NewProjectCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="Add" FontSize="12"/>
                                <TextBlock Text="새 프로젝트 만들기" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Height="44" FontSize="15" Margin="12,0,0,0" Content="모델 점검부터 해 보기" Command="{Binding QuickCheckCommand}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="받아 둔 파일" Style="{StaticResource Text.Subtitle}"/>
                            <TextBlock Style="{StaticResource Text.Help}" TextWrapping="Wrap" Margin="0,4,0,10" Text="다시 설치할 때 또 받지 않도록 남겨 두었어요. 필요 없으면 지워도 됩니다."/>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="components\downloads · cache" Style="{StaticResource Text.Caption}" FontSize="13"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding KeptText}" Style="{StaticResource Text.Body}" FontSize="13"/>
                            </DockPanel>
                            <Button Style="{StaticResource Button.Secondary}" Margin="0,12,0,0" Content="받아 둔 파일 지우기" Command="{Binding DeleteKeptCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- ================= ④ stopped ================= -->
        <DockPanel Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="{Binding FailTitle}" Style="{StaticResource Page.Title}"/>
                <c:Chip DockPanel.Dock="Left" Text="설치 멈춤" Kind="Bad" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="설치한 것은 없고, 이전 상태 그대로입니다" Style="{StaticResource Page.Note}"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="312"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Callout.Danger}" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Callout.Text}">
                            <Run Text="{Binding FailHeadline, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding FailText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource Components.Step}" Focusable="False"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding RetryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="Refresh" FontSize="12"/>
                                <TextBlock Text="다시 받기" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" Command="{Binding OpenLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="Folder" FontSize="13"/>
                                <TextBlock Text="기록 폴더 열기" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Callout.Warning}">
                        <TextBlock Style="{StaticResource Callout.Text}"
                                   Text="받는 도중 연결이 끊겨도 이 화면이 나와요. 다시 받기를 누르면 그 파일부터 다시 받고, 이미 다 받은 파일은 다시 받지 않습니다."/>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
