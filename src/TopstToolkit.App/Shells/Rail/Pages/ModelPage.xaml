<UserControl x:Class="TopstToolkit.App.Shells.Rail.Pages.ModelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:vm="clr-namespace:TopstToolkit.App.ViewModels"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
    <!-- Step 1 "모델" in layout A (docs/mockups/mockup-check-cut.html, screens 1 and 3). DataContext: ModelStepViewModel. -->
    <UserControl.Resources>
        <!-- one of the three summary tiles of the check card. DataContext: vm:CheckTile -->
        <DataTemplate x:Key="Check.Tile" DataType="{x:Type vm:CheckTile}">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="value" Text="{Binding Value}" FontFamily="{StaticResource Font.Ui}" FontSize="21" FontWeight="Bold"
                               LineHeight="28" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Brush.Text.Heading}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Bad"><Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- an operator the NPU cannot run. DataContext: vm:CheckLayerRow -->
        <DataTemplate x:Key="Check.Layer" DataType="{x:Type vm:CheckLayerRow}">
            <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="0,5" ToolTip="{Binding Tip}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Type}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.Status.Danger}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Style="{StaticResource Text.Body}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- the guidance box takes the tone of what it says -->
        <Style x:Key="Guess.Box" TargetType="Border" BasedOn="{StaticResource Callout}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding GuessKind}" Value="Warn">
                    <Setter Property="Background" Value="{StaticResource Brush.Status.WarningBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.WarningDot}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GuessKind}" Value="Bad">
                    <Setter Property="Background" Value="{StaticResource Brush.Status.DangerBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,22,32,20">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="1 모델" Style="{StaticResource Page.Title}"/>
            <c:Chip DockPanel.Dock="Left" Text="가져옴" Kind="Ok" Margin="10,0,0,0" Visibility="{Binding HasModel, Converter={StaticResource VisibleWhen}}"/>
            <c:Chip DockPanel.Dock="Left" Text="{Binding StateChipText}" Kind="{Binding StateChipKind}" Margin="6,0,0,0"
                    Visibility="{Binding StateChipText, Converter={StaticResource VisibleWhen}}"/>
            <TextBlock DockPanel.Dock="Right" Text="모델을 가져오면 묻지 않고 바로 점검합니다 · 원본 파일은 그대로 둡니다" Style="{StaticResource Page.Note}"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="-3,-3,-13,0" Padding="3,3,13,0">
                <StackPanel>
                    <!-- no model yet: the whole column is the drop zone -->
                    <Grid Height="250" Visibility="{Binding HasModel, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <Rectangle Style="{StaticResource Drop.Frame}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <c:Icon Glyph="Upload" FontSize="30" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="모델 파일을 여기에 끌어다 놓으세요" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                            <TextBlock Text=".onnx · .tflite · .cfg + .weights · .enlight" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource Button.Primary}" Content="파일 고르기" Command="{Binding PickCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- a model is in -->
                    <StackPanel Visibility="{Binding HasModel, Converter={StaticResource VisibleWhen}}">
                        <Border Style="{StaticResource Card}">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.Brand.PrimaryTint}">
                                    <c:Icon Glyph="Document" FontSize="18" Foreground="{StaticResource Brush.Brand.Primary}"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Subtitle}" ToolTip="{Binding FileOrigin}"/>
                                    <TextBlock Text="{Binding FileSummary}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="다른 모델로 바꾸기" Command="{Binding PickCommand}" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" ToolTip="다른 파일을 이 화면에 끌어다 놓아도 됩니다"/>
                            </DockPanel>
                        </Border>

                        <!-- the check is running -->
                        <Border Style="{StaticResource Card.Flat}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                            <StackPanel Orientation="Horizontal">
                                <c:StatusDot State="Running" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.BodyStrong}" Margin="8,0,0,0"/>
                                <TextBlock Text="아래 로그에서 진행을 볼 수 있어요." Style="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- check first: what the NPU cannot run, and what is done about it -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="NPU 점검" Style="{StaticResource Text.Subtitle}"/>
                                    <c:Chip DockPanel.Dock="Left" Text="{Binding CheckChipText}" Kind="{Binding CheckChipKind}" Margin="10,0,0,0"
                                            Visibility="{Binding CheckChipText, Converter={StaticResource VisibleWhen}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CheckCaption}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <c:CheckStrip Margin="0,12,0,0" Mode="{Binding StripMode}" RunText="{Binding StripRunText}" TailText="{Binding StripTailText}"
                                              CutText="{Binding StripCutText}" Ticks="{Binding StripTicks}"/>

                                <StackPanel Margin="0,10,0,0" Visibility="{Binding CheckMessageTitle, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="{Binding CheckMessageTitle}" Style="{StaticResource Text.BodyStrong}"/>
                                    <TextBlock Text="{Binding CheckMessageDetail}" Style="{StaticResource Text.Secondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Check.Tile}" Focusable="False" Margin="0,10,-12,0"
                                              Visibility="{Binding HasTiles, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Primary}" Command="{Binding OpenGraphCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowGraphPrimary, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Glyph="Graph" FontSize="14" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding GraphButtonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Primary}" Command="{Binding NextCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowNextPrimary, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NextText}" VerticalAlignment="Center"/>
                                            <c:Icon Glyph="ArrowRight" FontSize="12" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Command="{Binding RecheckCommand}" Content="{Binding RecheckText}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowRecheck, Converter={StaticResource VisibleWhen}}"/>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Command="{Binding OpenGraphCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowGraphSecondary, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Glyph="Graph" FontSize="14" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding GraphButtonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Command="{Binding NextCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowNextSecondary, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NextText}" VerticalAlignment="Center"/>
                                            <c:Icon Glyph="ArrowRight" FontSize="12" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}" Command="{Binding PickCommand}" Content="다른 모델 가져오기" Margin="0,0,8,0"
                                            Visibility="{Binding SuggestOtherModel, Converter={StaticResource VisibleWhen}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NextNote}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- no file card and no structure card (2026-11-23): the summary under the name says what the model is,
                             and the copies in the project (the cut model, the grid file) are the app's business -->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-13,0" Padding="0,0,13,0">
                <StackPanel>
                    <Border Style="{StaticResource Callout.Danger}" Margin="0,0,0,12" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Callout.Text}"/>
                    </Border>
                    <Border Style="{StaticResource Guess.Box}" Margin="0,0,0,12" Visibility="{Binding HasModel, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding GuessTitle}" Style="{StaticResource Callout.Text}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Heading}"/>
                            <TextBlock Text="{Binding GuessReason}" Style="{StaticResource Callout.Text}"/>
                            <Button Style="{StaticResource Button.Primary}" Content="지금 준비하기" Command="{Binding PrepareCommand}" HorizontalAlignment="Left" Margin="0,10,0,2"
                                    ToolTip="모델을 점검하고, 박스 계산 부분을 떼어내 보드가 계산하도록 준비합니다. 몇 초 걸려요."
                                    Visibility="{Binding CanPrepare, Converter={StaticResource VisibleWhen}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasAfter, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="잘라낸 부분" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding After}" ItemTemplate="{StaticResource Part.Fact}" Focusable="False"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,12" Visibility="{Binding HasBadLayers, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="{Binding BadLayersTitle}" Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding BadLayers}" ItemTemplate="{StaticResource Check.Layer}" Focusable="False"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Callout.Warning}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <c:Icon DockPanel.Dock="Left" Glyph="Warning" FontSize="16" Foreground="{StaticResource Brush.Status.Warning}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Callout.Text}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card.Flat}" Visibility="{Binding HasModel, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="모델 파일 하나면 됩니다" Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="학습한 프로그램에서 내보낸 파일을 그대로 넣으세요. 가져오는 즉시 NPU에서 돌아가는지 점검하고, 필요한 준비는 앱이 합니다."/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="모델 파일이 없으면 왼쪽의 모델 모음에서 골라도 됩니다."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
