<UserControl x:Class="TopstToolkit.App.Shells.Rail.Pages.CheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:rail="clr-namespace:TopstToolkit.App.Shells.Rail"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
    <!-- Tool "모델 점검" in layout A. DataContext: ModelCheckViewModel. -->
    <DockPanel Margin="32,22,32,20">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="모델 점검" Style="{StaticResource Page.Title}"/>
            <c:Chip DockPanel.Dock="Left" Text="{Binding ChipText}" Kind="{Binding ChipKind}" Margin="10,0,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}"/>
            <TextBlock DockPanel.Dock="Right" Text="프로젝트를 만들지 않고 NPU에서 돌아가는지만 확인합니다" Style="{StaticResource Page.Note}"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="-3,-3,-13,0" Padding="3,3,13,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <Border Style="{StaticResource Callout.Danger}" Margin="0,0,0,12" Visibility="{Binding EngineMissing, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="엔진이 아직 설치되지 않아 점검할 수 없어요. 처음 한 번 공식 사이트에서 받아 설치하면 됩니다." Style="{StaticResource Callout.Text}"/>
                        <Button Style="{StaticResource Button.Link}" Content="엔진 설치하러 가기 →" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=rail:RailShell}}"
                                CommandParameter="{Binding DataContext.HomeItem, RelativeSource={RelativeSource AncestorType=rail:RailShell}}"/>
                    </StackPanel>
                </Border>

                <Grid Width="860">
                    <Rectangle Style="{StaticResource Drop.Frame}"/>
                    <DockPanel Margin="18" LastChildFill="False">
                        <c:Icon DockPanel.Dock="Left" Glyph="Shield" FontSize="24" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="점검할 모델 파일을 여기에 끌어다 놓으세요" Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Text=".onnx · .tflite · .cfg + .weights · .enlight — 보통 몇 초에서 1분쯤 걸립니다" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="파일 고르기" VerticalAlignment="Center" Command="{Binding PickCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
                    </DockPanel>
                </Grid>

                <Border Style="{StaticResource Callout.Danger}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Callout.Text}"/>
                </Border>

                <Border Style="{StaticResource Card.Flat}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <c:StatusDot State="Running" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.BodyStrong}" Margin="8,0,0,0"/>
                        <TextBlock Text="을(를) 살펴보는 중입니다. 아래 로그에서 진행을 볼 수 있어요." Style="{StaticResource Text.Secondary}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- the answer -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}">
                    <Border Style="{StaticResource Card}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" MaxWidth="600">
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Muted}"/>
                                <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding SummaryDetail}" Style="{StaticResource Text.Secondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="이 모델로 프로젝트 만들기" Command="{Binding CreateProjectCommand}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasLayers, Converter={StaticResource VisibleWhen}}">
                        <Control Template="{StaticResource Part.LayerHead}" Focusable="False"/>
                        <ItemsControl ItemsSource="{Binding Layers}" ItemTemplate="{StaticResource Part.LayerProblem}" Focusable="False"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
