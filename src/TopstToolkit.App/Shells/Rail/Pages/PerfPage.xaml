<UserControl x:Class="TopstToolkit.App.Shells.Rail.Pages.PerfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls">
    <!-- Step 6 "성능" in layout A. DataContext: PerfViewModel. -->
    <Grid Margin="32,22,32,20">
        <Grid Visibility="{Binding HasData, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <TextBlock Text="6 성능" Style="{StaticResource Text.Title}" VerticalAlignment="Top"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <c:VoxelArt Voxels="0,0,0;1,0,0;2,0,0;1,0,1;1,0,2" Unit="14" HorizontalAlignment="Center"/>
                <TextBlock Text="아직 빌드하지 않았어요" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                <TextBlock Text="4 빌드를 끝내면 보드에서의 추정 추론 시간과 메모리를 보여 드립니다." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Style="{StaticResource Button.Secondary}" Content="4 빌드로 가기" Command="{Binding GoToBuildCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <DockPanel Visibility="{Binding HasData, Converter={StaticResource VisibleWhen}}">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="6 성능" Style="{StaticResource Page.Title}"/>
                <c:Chip DockPanel.Dock="Left" Text="추정값" Kind="Info" Margin="10,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNote}" Style="{StaticResource Page.Note}"/>
            </DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Callout.Warning}" Margin="0,0,0,12" Visibility="{Binding IsStale, Converter={StaticResource VisibleWhen}}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="설정이 바뀌었어요. 아래는 이전 빌드의 숫자입니다." Style="{StaticResource Callout.Text}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="4 빌드로 가기 →" Command="{Binding GoToBuildCommand}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding GoToExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="다음: 7 내보내기" VerticalAlignment="Center"/>
                        <c:Icon Glyph="ArrowRight" FontSize="12" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="312"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="-16,-16,-13,0" Padding="16,16,13,16">
                    <StackPanel>
                        <!-- the headline number on the one dark surface -->
                        <Grid>
                            <Border Style="{StaticResource Card.NightGlow}"/>
                            <Border Style="{StaticResource Card.Night}" Padding="28,24">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="보드에서의 추정 추론 시간" Style="{StaticResource Text.Caption}" FontSize="13" Foreground="{StaticResource Brush.Night.Caption}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Font.Brand}" FontSize="52" FontWeight="Bold" Foreground="White"
                                                       LineStackingStrategy="BlockLineHeight" LineHeight="56"/>
                                            <TextBlock Text="ms" FontFamily="{StaticResource Font.Brand}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,9" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeCaption}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Night.Caption}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource Font.Ui}" FontSize="18" FontWeight="SemiBold" TextAlignment="Right">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#72E7AD" Offset="0"/>
                                                    <GradientStop Color="#3D8AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="전처리 · 후처리 시간 제외" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Night.Caption}" TextAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="보드에서 쓰는 메모리" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalMemoryText}" FontFamily="{StaticResource Font.Brand}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Buffers}" ItemTemplate="{StaticResource Part.Bar}" Focusable="False"/>
                                    <TextBlock Text="보드 프로그램이 NPU용으로 잡아 두는 크기입니다." Style="{StaticResource Text.Help}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasGroups, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="계산이 많은 곳" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpsText}" FontFamily="{StaticResource Font.Brand}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center" ToolTip="합성곱 곱셈·덧셈 횟수 (MAC)"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource Part.Bar}" Focusable="False"/>
                                    <TextBlock Text="{Binding GroupsCaption}" Style="{StaticResource Text.Help}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="추정값이에요" Style="{StaticResource Text.Subtitle}"/>
                                <c:Chip DockPanel.Dock="Right" Text="{Binding ClockChipText}" Kind="{Binding ClockChipKind}" ToolTip="{Binding ClocksText}"/>
                            </DockPanel>
                            <!-- the clocks themselves (CCLK, ACLK ...) are in the chip's tooltip: a beginner needs the sentence, not the table -->
                            <TextBlock Text="{Binding ClockNote}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="네트워크" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Network}" ItemTemplate="{StaticResource Part.Fact}" Focusable="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
