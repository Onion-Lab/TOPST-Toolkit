<UserControl x:Class="TopstToolkit.App.ShellHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TopstToolkit.App.Controls"
             xmlns:app="clr-namespace:TopstToolkit.App"
             Background="{StaticResource Brush.Surface.Window}"
             Foreground="{StaticResource Brush.Text.Primary}"
             FontFamily="{StaticResource Font.Ui}" FontSize="14"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- The window's whole content: the title bar plus one screen layout (decision D9). Rendered as-is for screen captures. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title bar: TOPST symbol + product name (the "spoonful of TOPST", design system §6). At 16 px the symbol is its
             simple form — the "T" of the top row and the middle column on whole pixels (design system §7), the same as the
             16 px frame of the app icon (build\gen-app-icon.py), with the symbol's gradient mapped onto it. -->
        <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Background="White">
            <DockPanel LastChildFill="False">
                <Canvas Width="16" Height="16" Margin="12,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Path Data="M1,1h2v2h-2z M4,1h2v2h-2z M7,1h2v2h-2z M10,1h2v2h-2z M13,1h2v2h-2z M7,4h2v2h-2z M7,7h2v2h-2z M7,10h2v2h-2z M7,13h2v2h-2z">
                        <Path.Fill>
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0.29,0" EndPoint="15.98,0">
                                <GradientStop Color="{StaticResource Color.Topst.Mint}" Offset="0"/>
                                <GradientStop Color="{StaticResource Color.Topst.Blue}" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Canvas>
                <TextBlock DockPanel.Dock="Left" Text="TOPST Toolkit" FontFamily="{StaticResource Font.Brand}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Caption.Close}" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="닫기">
                    <c:Icon Glyph="ChromeClose" FontSize="10"/>
                </Button>
                <Button x:Name="MaxButton" DockPanel.Dock="Right" Style="{StaticResource Button.Caption}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="최대화">
                    <c:Icon x:Name="MaxIcon" Glyph="ChromeMaximize" FontSize="10"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Caption}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="최소화">
                    <c:Icon Glyph="ChromeMinimize" FontSize="10"/>
                </Button>
            </DockPanel>
        </Border>

        <!-- the active screen layout: Shells\Rail (A) now; Shells\Pipeline (B) and Shells\Focus (C) later -->
        <ContentControl x:Name="LayoutHost" Grid.Row="1" Focusable="False"/>

        <!-- the start-up animation over the app (about 3.2 s, App.OnStartup); never in screen captures unless asked -->
        <app:IntroView x:Name="Intro" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</UserControl>
