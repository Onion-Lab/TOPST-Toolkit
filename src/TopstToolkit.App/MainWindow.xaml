<Window x:Class="TopstToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TopstToolkit.App"
        Title="TOPST Toolkit" Width="1280" Height="800" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="White">
    <!-- Our own title bar (32px) with the system's resize borders, snap and rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame">
        <app:ShellHost x:Name="Host"/>
    </Border>
</Window>
