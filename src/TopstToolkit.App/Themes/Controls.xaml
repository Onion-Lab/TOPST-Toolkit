<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TopstToolkit.App.Controls">
    <!-- Component styles (docs/design-system.md §8). Shared by every screen layout (D9). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== buttons: Tag carries the hover background ===== -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Tag" Value="{StaticResource Brush.Surface.Rail}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Brand.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}"/>
        <Setter Property="Tag" Value="{StaticResource Brush.Brand.PrimaryHover}"/>
    </Style>
    <Style x:Key="Button.Quiet" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="Button.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Button.Quiet.Small" TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
        <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- window caption buttons -->
    <Style x:Key="Button.Caption" TargetType="Button">
        <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="#444444"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Tag" Value="{StaticResource Brush.Surface.RailHover}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
        <Setter Property="Tag" Value="#E81123"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== rail item (layout A). DataContext: NavItem ===== -->
    <Style x:Key="Rail.Item" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,7" CornerRadius="1.5"
                                Background="{StaticResource Brush.Brand.Primary}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Surface.RailHover}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Card.Flat" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Rail}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- guidance box: 3px left line (the TOPST paragraph style in Telechips blue) -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0,8,8,0"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="Callout.Warning" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource Brush.Status.WarningBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.WarningDot}"/>
    </Style>
    <Style x:Key="Callout.Danger" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource Brush.Status.DangerBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Danger}"/>
    </Style>

    <!-- ===== chip: <c:Chip Kind="Ok" Text="완료"/> ===== -->
    <Style TargetType="c:Chip">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Chip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="9,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="pulse" Width="7" Height="7" Margin="0,0,5,0" Fill="{StaticResource Brush.Topst.Pulse}" Visibility="Collapsed"/>
                            <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource Font.Ui}" FontSize="12" FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Ok">
                            <Setter Property="Background" Value="{StaticResource Brush.Status.SuccessBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Warn">
                            <Setter Property="Background" Value="{StaticResource Brush.Status.WarningBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Bad">
                            <Setter Property="Background" Value="{StaticResource Brush.Status.DangerBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Danger}"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
                        </Trigger>
                        <Trigger Property="Kind" Value="Running">
                            <Setter Property="Background" Value="{StaticResource Brush.Brand.PrimaryTint}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
                            <Setter TargetName="pulse" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== progress: Pulse while running ===== -->
    <Style x:Key="Progress.Pulse" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Topst.Pulse}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Sunken}"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- table head cell text -->
    <Style x:Key="Table.Head" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Heading}"/>
    </Style>

    <!-- thin scroll viewer padding helper -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.Border.Default}"/>
    </Style>
</ResourceDictionary>
