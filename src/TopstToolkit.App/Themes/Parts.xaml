<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TopstToolkit.App.Controls"
                    xmlns:vm="clr-namespace:TopstToolkit.App.ViewModels">
    <!-- Small pieces several pages share: fact tables, bars, callouts with an icon, the layer table.
         They show layout-independent view model types, so every screen layout (D9) can use them. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml"/>
        <ResourceDictionary Source="Inputs.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <c:VisibleWhen x:Key="VisibleWhen"/>

    <!-- label left, value right. DataContext: vm:FactRow -->
    <DataTemplate x:Key="Part.Fact" DataType="{x:Type vm:FactRow}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="20" Margin="0,0,16,0"/>
            <TextBlock x:Name="v" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20" TextAlignment="Right"
                       ToolTip="{Binding Value}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mono}" Value="True">
                <Setter TargetName="v" Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter TargetName="v" Property="FontSize" Value="12.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- label on its own line, value under it: for long paths. DataContext: vm:FactRow -->
    <DataTemplate x:Key="Part.FactStacked" DataType="{x:Type vm:FactRow}">
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}"/>
            <TextBlock x:Name="v" Text="{Binding Value}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20" ToolTip="{Binding Value}"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Mono}" Value="True">
                <Setter TargetName="v" Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter TargetName="v" Property="FontSize" Value="12.5"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- name, amount and a bar. DataContext: vm:BarRow -->
    <DataTemplate x:Key="Part.Bar" DataType="{x:Type vm:BarRow}">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}"/>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Brand}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Heading}" VerticalAlignment="Center"/>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Progress.Pulse}" Foreground="{StaticResource Brush.Brand.Primary}"
                         Value="{Binding Fraction, Mode=OneWay}" Margin="0,5,0,0"/>
        </Grid>
    </DataTemplate>

    <!-- one layer the NPU cannot run. DataContext: vm:LayerProblem -->
    <DataTemplate x:Key="Part.LayerProblem" DataType="{x:Type vm:LayerProblem}">
        <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Index}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Mono}" ToolTip="{Binding Name}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20"/>
                <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource Text.Body}" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                           ToolTip="{Binding Original}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- head of the layer table -->
    <ControlTemplate x:Key="Part.LayerHead">
        <Border Background="{StaticResource Brush.Surface.TableHead}" CornerRadius="8" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="번호" Style="{StaticResource Table.Head}"/>
                <TextBlock Grid.Column="1" Text="레이어" Style="{StaticResource Table.Head}"/>
                <TextBlock Grid.Column="2" Text="종류" Style="{StaticResource Table.Head}"/>
                <TextBlock Grid.Column="3" Text="이유" Style="{StaticResource Table.Head}"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- page title row text -->
    <Style x:Key="Page.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Page.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- text inside a callout -->
    <Style x:Key="Callout.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <!-- dashed drop zone frame -->
    <Style x:Key="Drop.Frame" TargetType="Rectangle">
        <Setter Property="RadiusX" Value="12"/>
        <Setter Property="RadiusY" Value="12"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Surface.Rail}"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.Border.Control}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeDashArray" Value="4 3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
</ResourceDictionary>
